generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  avatar_url String?
  created_at DateTime @default(now())
  
  hosted_meetings Meeting[]     @relation("HostedMeetings")
  participations  Participant[]
}

model Meeting {
  id               Int      @id @default(autoincrement())
  meeting_id       String   @unique
  title            String   @default("Zoom Meeting")
  description      String?
  host_id          Int
  status           String   @default("scheduled") // "scheduled" | "active" | "ended"
  scheduled_at     DateTime?
  duration_minutes Int      @default(60)
  invite_link      String?
  passcode         String
  created_at       DateTime @default(now())
  ended_at         DateTime?
  
  host         User          @relation("HostedMeetings", fields: [host_id], references: [id])
  participants Participant[]
  messages     Message[]
}

model Participant {
  id           Int      @id @default(autoincrement())
  meeting_id   Int
  user_id      Int?
  display_name String
  role         String   @default("participant") // "host" | "co-host" | "participant"
  is_muted     Boolean  @default(false)
  is_video_on  Boolean  @default(true)
  joined_at    DateTime @default(now())
  left_at      DateTime?
  
  meeting Meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [user_id], references: [id])
}

model Message {
  id          Int      @id @default(autoincrement())
  meeting_id  Int
  sender_name String
  text        String
  created_at  DateTime @default(now())
  
  meeting Meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
}
